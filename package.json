{
  "name": "resume-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/http.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-widget.mjs",
    "start": "tsx server/http.ts",
    "mcp": "tsx server/mcp.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "browser:open": "npx --yes --package @playwright/cli playwright-cli open http://127.0.0.1:4318 --browser msedge"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/multipart": "^9.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "fastify": "^5.12.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
